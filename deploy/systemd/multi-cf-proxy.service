# 參考 unit；實際安裝以 install.sh 生成版為準
# （install.sh 會先裝此加固版，環境不支援沙箱時自動回退零沙箱相容版）
[Unit]
Description=Multi-CF-Proxy (多開CF代理)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/etc/multi-cf-proxy/multi-cf-proxy -config /etc/multi-cf-proxy/config.json
Restart=always
RestartSec=5
User=multi-cf-proxy
Group=multi-cf-proxy
ReadWritePaths=/etc/multi-cf-proxy
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
