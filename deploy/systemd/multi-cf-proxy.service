[Unit]
Description=Multi-CF-Proxy (多開CF代理)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/multi-cf-proxy -config /var/lib/multi-cf-proxy/config.json
Restart=always
RestartSec=5
# 專用靜態系統帳戶（install.sh 創建）。DynamicUser 在部分容器化 VPS 上
# 會導致 exec EACCES（203/EXEC），故不使用。
User=multi-cf-proxy
Group=multi-cf-proxy
StateDirectory=multi-cf-proxy
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
